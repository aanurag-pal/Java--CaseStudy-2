import java.util.Scanner;

public class OnlineShopping {

    
    static void checkPrice(double price) {
        if (price <= 0) {
            throw new IllegalArgumentException(
                "Invalid product price! Price must be greater than 0."
            );
        }
    }

    
    static void checkQuantity(int quantity) {
        if (quantity <= 0) {
            throw new IllegalArgumentException(
                "Invalid quantity! Quantity must be greater than 0."
            );
        }
    }

    
    static void checkDiscount(double discount) {
        if (discount < 0 || discount > 100) {
            throw new IllegalArgumentException(
                "Invalid discount! Discount must be between 0 and 100."
            );
        }
    }

    
    static double calculateBill(double price, int quantity, double discount) {

        double total = price * quantity;

        double discountAmount = total * discount / 100;

        double finalAmount = total - discountAmount;

        return finalAmount;
    }

    
    static void checkPayment(double payment, double bill) {
        if (payment < bill) {
            throw new IllegalArgumentException(
                "Payment is less than the bill! Bill amount is: " + bill
            );
        }

        System.out.println("Payment successful!");
        System.out.println("Change: " + (payment - bill));
    }

    
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        try {
            System.out.print("Enter product price: ");
            double price = sc.nextDouble();

            checkPrice(price);

            System.out.print("Enter quantity: ");
            int quantity = sc.nextInt();

            checkQuantity(quantity);

            System.out.print("Enter discount percentage: ");
            double discount = sc.nextDouble();

            checkDiscount(discount);

            double bill = calculateBill(price, quantity, discount);

            System.out.println("Final bill: " + bill);

            System.out.print("Enter payment amount: ");
            double payment = sc.nextDouble();

            checkPayment(payment, bill);

        } catch (java.util.InputMismatchException e) {
            System.out.println("Invalid input! Please enter numbers only.");

        } catch (IllegalArgumentException e) {
            System.out.println(e.getMessage());

        } finally {
            sc.close();
        }
    }
}
