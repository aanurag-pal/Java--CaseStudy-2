import java.util.Scanner;

public class StudentResult {

    
    static void checkMarks(int marks) {
        if (marks < 0 || marks > 100) {
            throw new IllegalArgumentException(
                "Invalid marks! Marks must be between 0 and 100."
            );
        }
    }

    
    static double calculateAverage(int total, int subjects) {
        if (subjects == 0) {
            throw new ArithmeticException(
                "Division by zero! No subjects were entered."
            );
        }

        return (double) total / subjects;
    }

    
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        try {
            System.out.print("Enter number of subjects: ");
            int subjects = sc.nextInt();

            int total = 0;

            for (int i = 1; i <= subjects; i++) {

                System.out.print("Enter marks for subject " + i + ": ");
                int marks = sc.nextInt();

                checkMarks(marks);

                total = total + marks;
            }

            double average = calculateAverage(total, subjects);

            System.out.println("Total marks: " + total);
            System.out.println("Average marks: " + average);

        } catch (java.util.InputMismatchException e) {
            System.out.println("Invalid input! Please enter numbers only.");

        } catch (IllegalArgumentException e) {
            System.out.println(e.getMessage());

        } catch (ArithmeticException e) {
            System.out.println(e.getMessage());

        } finally {
            sc.close();
        }
    }
}
